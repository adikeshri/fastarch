# Copy to .env for local development. Never commit a real .env file.
# See docs/configuration.md for the full reference and per-environment guidance.

ENVIRONMENT=development
API_PREFIX=/api
PROJECT_NAME=fastarch
DEBUG=true

# -- Database ----------------------------------------------------------------
DATABASE__URL=postgresql+asyncpg://fastarch:fastarch@localhost:5432/fastarch
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=10
DATABASE__POOL_TIMEOUT_SECONDS=30
DATABASE__ECHO=false

# -- Redis (caching, idempotency, messaging, background jobs) ----------------
REDIS__URL=redis://localhost:6379/0
REDIS__MAX_CONNECTIONS=20

# -- Auth ----------------------------------------------------------------
# Generate a real secret with: openssl rand -hex 32
AUTH__JWT_SECRET=change-me-in-every-real-environment
AUTH__JWT_ALGORITHM=HS256
AUTH__JWT_ISSUER=fastarch
AUTH__JWT_AUDIENCE=fastarch-api
AUTH__ACCESS_TOKEN_TTL_MINUTES=30

# -- Observability -------------------------------------------------------
OBSERVABILITY__SERVICE_NAME=fastarch
OBSERVABILITY__OTLP_ENDPOINT=
OBSERVABILITY__TRACES_ENABLED=true
OBSERVABILITY__METRICS_ENABLED=true
OBSERVABILITY__LOG_LEVEL=INFO
OBSERVABILITY__JSON_LOGS=false

# -- Security --------------------------------------------------------------
SECURITY__CORS_ALLOW_ORIGINS=["http://localhost:3000"]
SECURITY__TRUSTED_HOSTS=["*"]

# -- Outbox relay ------------------------------------------------------------
OUTBOX_RELAY_INTERVAL_SECONDS=1.0
OUTBOX_RELAY_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
